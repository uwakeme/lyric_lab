{
  "name": "lyriclab-server",
  "cwd": "/home/ubuntu/deploy/lyric_lab/server",
  "script": "app.js",
  "exec_mode": "fork",
  "instances": 1,
  "autorestart": true,
  "watch": false,
  "max_memory_restart": "500M",
  "env": {
    "NODE_ENV": "production",
    "PORT": "3001"
  },
  "error_file": "/home/ubuntu/deploy/lyric_lab/logs/lyriclab-error.log",
  "out_file": "/home/ubuntu/deploy/lyric_lab/logs/lyriclab-out.log",
  "merge_logs": true,
  "time": true
}
