[{"id":"fb-001","title":"但愿人长久","artist":"邓丽君","category":"古典诗词","source":"词：苏轼《水调歌头·明月几时有》（宋，公有领域）","lyrics":[{"id":"fb-001-s1","title":"上阕","lines":[{"id":"fb-001-s1-1","text":"明月几时有？","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-2","text":"把酒问青天。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-3","text":"不知天上宫阙，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-4","text":"今夕是何年。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-5","text":"我欲乘风归去，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-6","text":"又恐琼楼玉宇，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-7","text":"高处不胜寒。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-8","text":"起舞弄清影，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s1-9","text":"何似在人间。","charCount":5,"rhymeStatus":"unchecked"}]},{"id":"fb-001-s2","title":"下阕","lines":[{"id":"fb-001-s2-1","text":"转朱阁，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-2","text":"低绮户，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-3","text":"照无眠。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-4","text":"不应有恨、","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-5","text":"何事长向别时圆？","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-6","text":"人有悲欢离合，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-7","text":"月有阴晴圆缺，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-8","text":"此事古难全。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-9","text":"但愿人长久，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-001-s2-10","text":"千里共婵娟。","charCount":5,"rhymeStatus":"unchecked"}]}]},{"id":"fb-002","title":"独上西楼","artist":"邓丽君","category":"古典诗词","source":"词：李煜《相见欢·无言独上西楼》（南唐，公有领域）","lyrics":[{"id":"fb-002-s1","title":"相见欢","lines":[{"id":"fb-002-s1-1","text":"无言独上西楼，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-2","text":"月如钩。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-3","text":"寂寞梧桐深院锁清秋。","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-4","text":"剪不断，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-5","text":"理还乱，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-6","text":"是离愁。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-002-s1-7","text":"别是一般滋味在心头。","charCount":9,"rhymeStatus":"unchecked"}]}]},{"id":"fb-003","title":"几多愁","artist":"邓丽君","category":"古典诗词","source":"词：李煜《虞美人·春花秋月何时了》（南唐，公有领域）","lyrics":[{"id":"fb-003-s1","title":"上阕","lines":[{"id":"fb-003-s1-1","text":"春花秋月何时了？","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-003-s1-2","text":"往事知多少。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-003-s1-3","text":"小楼昨夜又东风，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-003-s1-4","text":"故国不堪回首月明中。","charCount":9,"rhymeStatus":"unchecked"}]},{"id":"fb-003-s2","title":"下阕","lines":[{"id":"fb-003-s2-1","text":"雕栏玉砌应犹在，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-003-s2-2","text":"只是朱颜改。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-003-s2-3","text":"问君能有几多愁？","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-003-s2-4","text":"恰似一江春水向东流。","charCount":9,"rhymeStatus":"unchecked"}]}]},{"id":"fb-004","title":"胭脂泪","artist":"邓丽君","category":"古典诗词","source":"词：李煜《乌夜啼·林花谢了春红》（南唐，公有领域）","lyrics":[{"id":"fb-004-s1","title":"乌夜啼","lines":[{"id":"fb-004-s1-1","text":"林花谢了春红，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-2","text":"太匆匆。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-3","text":"无奈朝来寒雨晚来风。","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-4","text":"胭脂泪，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-5","text":"相留醉，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-6","text":"几时重。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-004-s1-7","text":"自是人生长恨水长东。","charCount":9,"rhymeStatus":"unchecked"}]}]},{"id":"fb-005","title":"芳草无情","artist":"邓丽君","category":"古典诗词","source":"词：范仲淹《苏幕遮·碧云天》（宋，公有领域）","lyrics":[{"id":"fb-005-s1","title":"上阕","lines":[{"id":"fb-005-s1-1","text":"碧云天，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-2","text":"黄叶地，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-3","text":"秋色连波，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-4","text":"波上寒烟翠。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-5","text":"山映斜阳天接水，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-6","text":"芳草无情，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-005-s1-7","text":"更在斜阳外。","charCount":5,"rhymeStatus":"unchecked"}]},{"id":"fb-005-s2","title":"下阕","lines":[{"id":"fb-005-s2-1","text":"黯乡魂，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-2","text":"追旅思，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-3","text":"夜夜除非，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-4","text":"好梦留人睡。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-5","text":"明月楼高休独倚，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-6","text":"酒入愁肠，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-005-s2-7","text":"化作相思泪。","charCount":5,"rhymeStatus":"unchecked"}]}]},{"id":"fb-006","title":"清夜悠悠","artist":"邓丽君","category":"古典诗词","source":"词：秦观《桃源忆故人·玉楼深锁薄情种》（宋，公有领域）","lyrics":[{"id":"fb-006-s1","title":"上阕","lines":[{"id":"fb-006-s1-1","text":"玉楼深锁薄情种，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-006-s1-2","text":"清夜悠悠谁共？","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-006-s1-3","text":"羞见枕衾鸳凤，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-006-s1-4","text":"闷即和衣拥。","charCount":5,"rhymeStatus":"unchecked"}]},{"id":"fb-006-s2","title":"下阕","lines":[{"id":"fb-006-s2-1","text":"无端画角严城动，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-006-s2-2","text":"惊破一番新梦。","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-006-s2-3","text":"窗外月华霜重，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-006-s2-4","text":"听彻梅花弄。","charCount":5,"rhymeStatus":"unchecked"}]}]},{"id":"fb-007","title":"有谁知我此时情","artist":"邓丽君","category":"古典诗词","source":"词：聂胜琼《鹧鸪天·别情》（宋，公有领域）","lyrics":[{"id":"fb-007-s1","title":"上阕","lines":[{"id":"fb-007-s1-1","text":"玉惨花愁出凤城，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-007-s1-2","text":"莲花楼下柳青青。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-007-s1-3","text":"尊前一唱阳关曲，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-007-s1-4","text":"别个人人第五程。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-007-s2","title":"下阕","lines":[{"id":"fb-007-s2-1","text":"寻好梦，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-007-s2-2","text":"梦难成。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-007-s2-3","text":"有谁知我此时情。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-007-s2-4","text":"枕前泪共阶前雨，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-007-s2-5","text":"隔个窗儿滴到明。","charCount":7,"rhymeStatus":"unchecked"}]}]},{"id":"fb-008","title":"万叶千声","artist":"邓丽君","category":"古典诗词","source":"词：欧阳修《玉楼春·别后不知君远近》（宋，公有领域）","lyrics":[{"id":"fb-008-s1","title":"上阕","lines":[{"id":"fb-008-s1-1","text":"别后不知君远近，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s1-2","text":"触目凄凉多少闷。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s1-3","text":"渐行渐远渐无书，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s1-4","text":"水阔鱼沉何处问。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-008-s2","title":"下阕","lines":[{"id":"fb-008-s2-1","text":"夜深风竹敲秋韵，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s2-2","text":"万叶千声皆是恨。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s2-3","text":"故欹单枕梦中寻，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-008-s2-4","text":"梦又不成灯又烬。","charCount":7,"rhymeStatus":"unchecked"}]}]},{"id":"fb-009","title":"人约黄昏后","artist":"邓丽君","category":"古典诗词","source":"词：《生查子·元夕》（宋，公有领域）","lyrics":[{"id":"fb-009-s1","title":"上阕","lines":[{"id":"fb-009-s1-1","text":"去年元夜时，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s1-2","text":"花市灯如昼。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s1-3","text":"月上柳梢头，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s1-4","text":"人约黄昏后。","charCount":5,"rhymeStatus":"unchecked"}]},{"id":"fb-009-s2","title":"下阕","lines":[{"id":"fb-009-s2-1","text":"今年元夜时，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s2-2","text":"月与灯依旧。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s2-3","text":"不见去年人，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-009-s2-4","text":"泪湿春衫袖。","charCount":5,"rhymeStatus":"unchecked"}]}]},{"id":"fb-010","title":"相看泪眼","artist":"邓丽君","category":"古典诗词","source":"词：柳永《雨霖铃·寒蝉凄切》（宋，公有领域）","lyrics":[{"id":"fb-010-s1","title":"上阕","lines":[{"id":"fb-010-s1-1","text":"寒蝉凄切，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-2","text":"对长亭晚，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-3","text":"骤雨初歇。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-4","text":"都门帐饮无绪，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-5","text":"留恋处、兰舟催发。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-6","text":"执手相看泪眼，","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-7","text":"竟无语凝噎。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-8","text":"念去去、千里烟波，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-010-s1-9","text":"暮霭沉沉楚天阔。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-010-s2","title":"下阕","lines":[{"id":"fb-010-s2-1","text":"多情自古伤离别，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-2","text":"更那堪、冷落清秋节！","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-3","text":"今宵酒醒何处？","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-4","text":"杨柳岸、晓风残月。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-5","text":"此去经年，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-6","text":"应是良辰好景虚设。","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-7","text":"便纵有千种风情，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-010-s2-8","text":"更与何人说？","charCount":5,"rhymeStatus":"unchecked"}]}]},{"id":"fb-011","title":"欲说还休","artist":"邓丽君","category":"古典诗词","source":"词：辛弃疾《丑奴儿·书博山道中壁》（宋，公有领域）","lyrics":[{"id":"fb-011-s1","title":"上阕","lines":[{"id":"fb-011-s1-1","text":"少年不识愁滋味，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-011-s1-2","text":"爱上层楼。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-011-s1-3","text":"爱上层楼，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-011-s1-4","text":"为赋新词强说愁。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-011-s2","title":"下阕","lines":[{"id":"fb-011-s2-1","text":"而今识尽愁滋味，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-011-s2-2","text":"欲说还休。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-011-s2-3","text":"欲说还休，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-011-s2-4","text":"却道天凉好个秋。","charCount":7,"rhymeStatus":"unchecked"}]}]},{"id":"fb-012","title":"思君","artist":"邓丽君","category":"古典诗词","source":"词：李之仪《卜算子·我住长江头》（宋，公有领域）","lyrics":[{"id":"fb-012-s1","title":"卜算子","lines":[{"id":"fb-012-s1-1","text":"我住长江头，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-2","text":"君住长江尾。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-3","text":"日日思君不见君，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-4","text":"共饮长江水。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-5","text":"此水几时休，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-6","text":"此恨何时已。","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-7","text":"只愿君心似我心，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-012-s1-8","text":"定不负相思意。","charCount":6,"rhymeStatus":"unchecked"}]}]},{"id":"fb-013","title":"月满西楼","artist":"安雯","category":"古典诗词","source":"词：李清照《一剪梅·红藕香残玉簟秋》（宋，公有领域）","lyrics":[{"id":"fb-013-s1","title":"上阕","lines":[{"id":"fb-013-s1-1","text":"红藕香残玉簟秋。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-013-s1-2","text":"轻解罗裳，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s1-3","text":"独上兰舟。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s1-4","text":"云中谁寄锦书来？","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-013-s1-5","text":"雁字回时，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s1-6","text":"月满西楼。","charCount":4,"rhymeStatus":"unchecked"}]},{"id":"fb-013-s2","title":"下阕","lines":[{"id":"fb-013-s2-1","text":"花自飘零水自流。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-013-s2-2","text":"一种相思，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s2-3","text":"两处闲愁。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s2-4","text":"此情无计可消除，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-013-s2-5","text":"才下眉头，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-013-s2-6","text":"却上心头。","charCount":4,"rhymeStatus":"unchecked"}]}]},{"id":"fb-014","title":"满江红","artist":"罗文","category":"古典诗词","source":"词：岳飞《满江红·怒发冲冠》（宋，公有领域）","lyrics":[{"id":"fb-014-s1","title":"上阕","lines":[{"id":"fb-014-s1-1","text":"怒发冲冠，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-2","text":"凭栏处、潇潇雨歇。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-3","text":"抬望眼、仰天长啸，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-4","text":"壮怀激烈。","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-5","text":"三十功名尘与土，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-6","text":"八千里路云和月。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-7","text":"莫等闲、","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-8","text":"白了少年头，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-014-s1-9","text":"空悲切！","charCount":3,"rhymeStatus":"unchecked"}]},{"id":"fb-014-s2","title":"下阕","lines":[{"id":"fb-014-s2-1","text":"靖康耻，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014-s2-2","text":"犹未雪。","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014-s2-3","text":"臣子恨，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014-s2-4","text":"何时灭！","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014-s2-5","text":"驾长车，","charCount":3,"rhymeStatus":"unchecked"},{"id":"fb-014