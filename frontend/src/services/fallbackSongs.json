ount":10,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-5","text":"那里有我的同胞，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-6","text":"还有那衰老的爹娘。","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-7","text":"九一八！九一八！","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-8","text":"从那个悲惨的时候！","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-9","text":"脱离了我的家乡，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-10","text":"抛弃那无尽的宝藏，","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-11","text":"流浪！流浪！","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-12","text":"整日价在关内，流浪！","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-13","text":"哪年？哪月？","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-14","text":"才能够回到我那可爱的故乡？","charCount":12,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-15","text":"哪年？哪月？","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-16","text":"才能够收回那无尽的宝藏？","charCount":11,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-17","text":"爹娘啊！爹娘啊！","charCount":6,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-18","text":"什么时候，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-020-s1-19","text":"才能欢聚一堂？","charCount":6,"rhymeStatus":"unchecked"}]}]},{"id":"fb-021","title":"天涯歌女","artist":"周璇","category":"经典老歌","source":"词：田汉（1968 卒，公有领域）；曲：贺绿汀 编（据苏州民歌）","lyrics":[{"id":"fb-021-s1","title":"主歌一","lines":[{"id":"fb-021-s1-1","text":"天涯呀海角，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-021-s1-2","text":"觅呀觅知音，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-021-s1-3","text":"小妹妹唱歌郎奏琴，","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-021-s1-4","text":"郎呀，咱们俩是一条心。","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-021-s1-5","text":"哎呀爱呀，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-021-s1-6","text":"郎呀，咱们俩是一条心。","charCount":9,"rhymeStatus":"unchecked"}]},{"id":"fb-021-s2","title":"主歌二","lines":[{"id":"fb-021-s2-1","text":"家山呀北望，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-021-s2-2","text":"泪呀泪沾襟，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-021-s2-3","text":"小妹妹想郎直到今，","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-021-s2-4","text":"郎呀，患难之交恩爱深。","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-021-s2-5","text":"哎呀爱呀，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-021-s2-6","text":"郎呀，患难之交恩爱深。","charCount":9,"rhymeStatus":"unchecked"}]},{"id":"fb-021-s3","title":"主歌三","lines":[{"id":"fb-021-s3-1","text":"人生呀谁不惜青春，","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-021-s3-2","text":"小妹妹似线郎似针，","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-021-s3-3","text":"郎呀，穿在一起不离分，","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-021-s3-4","text":"哎呀爱呀，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-021-s3-5","text":"郎呀，穿在一起不离分。","charCount":9,"rhymeStatus":"unchecked"}]}]},{"id":"fb-022","title":"四季歌","artist":"周璇","category":"经典老歌","source":"词：田汉（1968 卒，公有领域）","lyrics":[{"id":"fb-022-s1","title":"主歌一","lines":[{"id":"fb-022-s1-1","text":"春季到来绿满窗，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s1-2","text":"大姑娘窗下绣鸳鸯。","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-022-s1-3","text":"忽然一阵无情棒，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s1-4","text":"打得鸳鸯各一方。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-022-s2","title":"主歌二","lines":[{"id":"fb-022-s2-1","text":"夏季到来柳丝长，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s2-2","text":"大姑娘漂泊到长江。","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-022-s2-3","text":"江南江北风光好，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s2-4","text":"怎及青纱起高粱。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-022-s3","title":"主歌三","lines":[{"id":"fb-022-s3-1","text":"秋季到来荷花香，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s3-2","text":"大姑娘夜夜梦家乡。","charCount":8,"rhymeStatus":"unchecked"},{"id":"fb-022-s3-3","text":"醒来不见爹娘面，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s3-4","text":"只见窗前明月光。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-022-s4","title":"主歌四","lines":[{"id":"fb-022-s4-1","text":"冬季到来雪茫茫，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s4-2","text":"寒衣做好送情郎。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s4-3","text":"血肉筑出长城长，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-022-s4-4","text":"侬愿做当年小孟姜。","charCount":8,"rhymeStatus":"unchecked"}]}]},{"id":"fb-023","title":"茉莉花","artist":"江苏民歌","category":"经典老歌","source":"中国传统民歌（公有领域）","lyrics":[{"id":"fb-023-s1","title":"主歌","lines":[{"id":"fb-023-s1-1","text":"好一朵美丽的茉莉花，","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-2","text":"好一朵美丽的茉莉花，","charCount":9,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-3","text":"芬芳美丽满枝桠，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-4","text":"又香又白人人夸。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-5","text":"让我来将你摘下，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-6","text":"送给别人家，","charCount":5,"rhymeStatus":"unchecked"},{"id":"fb-023-s1-7","text":"茉莉花呀茉莉花。","charCount":7,"rhymeStatus":"unchecked"}]}]},{"id":"fb-024","title":"康定情歌","artist":"四川民歌","category":"经典老歌","source":"中国传统民歌（公有领域）","lyrics":[{"id":"fb-024-s1","title":"主歌一","lines":[{"id":"fb-024-s1-1","text":"跑马溜溜的山上，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s1-2","text":"一朵溜溜的云哟。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s1-3","text":"端端溜溜的照在，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s1-4","text":"康定溜溜的城哟。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s1-5","text":"月亮弯弯，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-024-s1-6","text":"康定溜溜的城哟。","charCount":7,"rhymeStatus":"unchecked"}]},{"id":"fb-024-s2","title":"主歌二","lines":[{"id":"fb-024-s2-1","text":"李家溜溜的大姐，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s2-2","text":"人才溜溜的好哟。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s2-3","text":"张家溜溜的大哥，","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s2-4","text":"看上溜溜的她哟。","charCount":7,"rhymeStatus":"unchecked"},{"id":"fb-024-s2-5","text":"月亮弯弯，","charCount":4,"rhymeStatus":"unchecked"},{"id":"fb-024-s2-6","text":"看上溜溜的她哟。","charCount":7,"rhymeStatus":"unchecked"}]}]},{"id":"fb-025","title":"Amazing Grace","artist":"John Newton","category":"国际经典","source":"词：John Newton（1807 卒，公有领域）；传统曲调","lyrics":[{"id":"fb-025-s1","title":"Verse 1","lines":[{"id":"fb-025-s1-1","text":"Amazing grace, how sweet the sound","charCount":28,"rhymeStatus":"unchecked"},{"id":"fb-025-s1-2","text":"That saved a wretch like me","charCount":22,"rhymeStatus":"unchecked"},{"id":"fb-025-s1-3","text":"I once was lost, but now am found","charCount":25,"rhymeStatus":"unchecked"},{"id":"fb-025-s1-4","text":"Was blind, but now I see","charCount":18,"rhymeStatus":"unchecked"}]},{"id":"fb-025-s2","title":"Verse 2","lines":[{"id":"fb-025-s2-1","text":"'Twas grace that taught my heart to fear","charCount":32,"rhymeStatus":"unchecked"},{"id":"fb-025-s2-2","text":"And grace my fears relieved","charCount":23,"rhymeStatus":"unchecked"},{"id":"fb-025-s2-3","text":"How precious did that grace appear","charCount":29,"rhymeStatus":"unchecked"},{"id":"fb-025-s2-4","text":"The hour I first believed","charCount":21,"rhymeStatus":"unchecked"}]},{"id":"fb-025-s3","title":"Verse 3","lines":[{"id":"fb-025-s3-1","text":"Through many dangers, toils and snares","charCount":32,"rhymeStatus":"unchecked"},{"id":"fb-025-s3-2","text":"I have already come","charCount":16,"rhymeStatus":"unchecked"},{"id":"fb-025-s3-3","text":"'Tis grace hath brought me safe thus far","charCount":32,"rhymeStatus":"unchecked"},{"id":"fb-025-s3-4","text":"And grace will lead me home","charCount":22,"rhymeStatus":"unchecked"}]}]},{"id":"fb-026","title":"Auld Lang Syne","artist":"Robert Burns","category":"国际经典","source":"词：Robert Burns（1796 卒，公有领域）","lyrics":[{"id":"fb-026-s1","title":"Verse","lines":[{"id":"fb-026-s1-1","text":"Should auld acquaintance be forgot","charCount":30,"rhymeStatus":"unchecked"},{"id":"fb-026-s1-2","text":"And never brought to mind","charCount":21,"rhymeStatus":"unchecked"},{"id":"fb-026-s1-3","text":"Should auld acquaintance be forgot","charCount":30,"rhymeStatus":"unchecked"},{"id":"fb-026-s1-4","text":"And auld lang syne","charCount":15,"rhymeStatus":"unchecked"}]},{"id":"fb-026-s2","title":"Chorus","lines":[{"id":"fb-026-s2-1","text":"For auld lang syne, my dear","charCount":21,"rhymeStatus":"unchecked"},{"id":"fb-026-s2-2","text":"For auld lang syne","charCount":15,"rhymeStatus":"unchecked"},{"id":"fb-026-s2-3","text":"We'll tak a cup o' kindness yet","charCount":23,"rhymeStatus":"unchecked"},{"id":"fb-026-s2-4","text":"For auld lang syne","charCount":15,"rhymeStatus":"unchecked"}]}]},{"id":"fb-027","title":"Scarborough Fair","artist":"Traditional","category":"国际经典","source":"英格兰传统民谣（公有领域）","lyrics":[{"id":"fb-027-s1","title":"Verse","lines":[{"id":"fb-027-s1-1","text":"Are you going to Scarborough Fair","charCount":28,"rhymeStatus":"unchecked"},{"id":"fb-027-s1-2","text":"Parsley, sage, rosemary and thyme","charCount":27,"rhymeStatus":"unchecked"},{"id":"fb-027-s1-3","text":"Remember me to one who lives there","charCount":28,"rhymeStatus":"unchecked"},{"id":"fb-027-s1-4","text":"'She once was a true love of mine'","charCount":25,"rhymeStatus":"unchecked"}]}]},{"id":"fb-028","title":"Greensleeves","artist":"Traditional","category":"国际经典","source":"英格兰传统民谣（公有领域）","lyrics":[{"id":"fb-028-s1","title":"Verse","lines":[{"id":"fb-028-s1-1","text":"Alas, my love, you do me wrong","charCount":22,"rhymeStatus":"unchecked"},{"id":"fb-028-s1-2","text":"To cast me off discourteously","charCount":25,"rhymeStatus":"unchecked"},{"id":"fb-028-s1-3","text":"For I have loved you well and long","charCount":27,"rhymeStatus":"unchecked"},{"id":"fb-028-s1-4","text":"Delighting in your company","charCount":23,"rhymeStatus":"unchecked"}]},{"id":"fb-028-s2","title":"Chorus","lines":[{"id":"fb-028-s2-1","text":"Greensleeves was all my joy","charCount":23,"rhymeStatus":"unchecked"},{"id":"fb-028-s2-2","text":"Greensleeves was my delight","charCount":24,"rhymeStatus":"unchecked"},{"id":"fb-028-s2-3","text":"Greensleeves was my heart of gold","charCount":28,"rhymeStatus":"unchecked"},{"id":"fb-028-s2-4","text":"And who but my lady Greensleeves","charCount":27,"rhymeStatus":"unchecked"}]}]},{"id":"fb-029","title":"Danny Boy","artist":"Frederick Weatherly","category":"国际经典","source":"词：Frederick Weatherly（1929 卒，公有领域）；传统曲调 Londonderry Air","lyrics":[{"id":"fb-029-s1","title":"Verse","lines":[{"id":"fb-029-s1-1","text":"Oh Danny boy, the pipes, the pipes are calling","charCount":36,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-2","text":"From glen to glen, and down the mountain side","charCount":36,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-3","text":"The summer's gone, and all the flowers are dying","charCount":38,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-4","text":"'Tis you, 'tis you must go and I must bide","charCount":30,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-5","text":"But come ye back when summer's in the meadow","charCount":35,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-6","text":"Or when the valley's hushed and white with snow","charCount":38,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-7","text":"'Tis I'll be here in sunshine or in shadow","charCount":32,"rhymeStatus":"unchecked"},{"id":"fb-029-s1-8","text":"Oh Danny boy, oh Danny boy, I love you so","charCount":30,"rhymeStatus":"unchecked"}]}]},{"id":"fb-030","title":"House of the Rising Sun","artist":"Traditional","category":"国际经典","source":"英美传统民谣（公有领域）","lyrics":[{"id":"fb-030-s1","title":"Verse","lines":[{"id":"fb-030-s1-1","text":"There is a house in New Orleans","charCount":25,"rhymeStatus":"unchecked"},{"id":"fb-030-s1-2","text":"They call the Rising Sun","charCount":20,"rhymeStatus":"unchecked"},{"id":"fb-030-s1-3","text":"And it's been the ruin of many a poor boy","charCount":31,"rhymeStatus":"unchecked"},{"id":"fb-030-s1-4","text":"And God, I know I'm one","charCount":16,"rhymeStatus":"unchecked"}]}]}]
